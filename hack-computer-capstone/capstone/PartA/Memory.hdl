CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // RAM selection: address 0 to 16383
    Not(in=address[14], out=notAddress14);
    And(a=load, b=notAddress14, out=ramLoad);

    RAM16K(
        in=in,
        load=ramLoad,
        address=address[0..13],
        out=ramOut
    );

    // Screen selection: address 16384 to 24575
    Not(in=address[13], out=notAddress13);
    And(a=address[14], b=notAddress13, out=screenSelect);
    And(a=load, b=screenSelect, out=screenLoad);

    Screen(
        in=in,
        load=screenLoad,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard output
    Keyboard(out=keyboardOut);

    // Select RAM or Screen
    Mux16(
        a=ramOut,
        b=screenOut,
        sel=address[14],
        out=ramScreenOut
    );

    // Select Keyboard when address[14] and address[13] are 1
    And(a=address[14], b=address[13], out=keyboardSelect);

    Mux16(
        a=ramScreenOut,
        b=keyboardOut,
        sel=keyboardSelect,
        out=out
    );
}